{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "allowJs": true,
    "skipLibCheck": true,
    "types": ["node", "vite/client"]
  },
  "include": ["lib", "cases", "tests", "measure.ts"],
  "exclude": ["lib/*.cjs"]
}
